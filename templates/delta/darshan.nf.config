// Darshan injection for nf-core + Apptainer/Singularity on Delta.
// Host Nextflow Java process does NOT get LD_PRELOAD'd.
// Containers get LD_PRELOAD injected via Apptainer/Singularity --env flag.
// /scratch is bind-mounted so the host-built libdarshan.so is accessible inside.
// DARSHAN_ENABLE_NONMPI=1 is required because nf-core processes are non-MPI;
// DARSHAN_LOGPATH overrides the configure-time default.

singularity {
    enabled = true
    autoMounts = true
    runOptions = '--bind /scratch/bekn/mtang9 --env LD_PRELOAD=/scratch/bekn/mtang9/tools/darshan/lib/libdarshan.so --env DARSHAN_ENABLE_NONMPI=1'
    envWhitelist = 'DARSHAN_LOGPATH,DARSHAN_LOG_DIR_PATH'
}

// DataLife injection for nf-core + Apptainer/Singularity on Delta.
// Host Nextflow Java process does NOT get LD_PRELOAD'd (libmonitor segfaults the JVM).
// Containers get LD_PRELOAD injected via Apptainer/Singularity --env flag.
// /scratch is bind-mounted so the host-built libmonitor.so is accessible inside.

singularity {
    enabled = true
    autoMounts = true
    runOptions = '--bind /scratch/bekn/mtang9 --env LD_PRELOAD=/scratch/bekn/mtang9/widget-v1/profiler/datalife/flow-monitor/build/src/libmonitor.so'
    envWhitelist = 'DATALIFE_OUTPUT_PATH,DATALIFE_FILE_PATTERNS,DATALIFE_TASK_NAME'
}

// Per-process: inject DATALIFE_TASK_NAME with the Nextflow process name so each
// trace JSON can carry `"task_name": "<NFCORE_METHYLSEQ:METHYLSEQ:FASTQC>"` or similar.
// Requires a libmonitor build from a branch that includes pnnl/datalife main's
// TrackFile.cpp:540 change (`getenv("DATALIFE_TASK_NAME")` → JSON `task_name`).
// The current widget-v1 fork lacks that change; this is a no-op until rebuilt.
process {
    containerOptions = { "--env DATALIFE_TASK_NAME=${task.process.replaceAll(':', '_')}" }
}

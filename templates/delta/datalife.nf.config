// DataLife injection for nf-core + Apptainer/Singularity on Delta.
// Host Nextflow Java process does NOT get LD_PRELOAD'd (libmonitor segfaults the JVM).
// Containers get LD_PRELOAD injected via Apptainer/Singularity --env flag.
// /scratch is bind-mounted so the host-built libmonitor.so is accessible inside.

singularity {
    enabled = true
    autoMounts = true
    runOptions = '--bind /scratch/bekn/mtang9 --env LD_PRELOAD=/scratch/bekn/mtang9/widget-v1/profiler/datalife/flow-monitor/build/src/libmonitor.so'
    envWhitelist = 'DATALIFE_OUTPUT_PATH,DATALIFE_FILE_PATTERNS'
}

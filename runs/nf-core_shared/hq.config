// HyperQueue executor config for nf-core (Class C) multi-node runs.
//
// Replaces the slurm executor's per-task child-sbatch model. Nextflow submits
// each task to a HyperQueue server (started by the launcher inside one SLURM
// allocation); HQ distributes tasks across HQ workers running on every node of
// the allocation. No child sbatch jobs, no --nodelist pinning, no --exclusive
// deadlock. Requires: hq binary in PATH and HQ_SERVER_DIR exported by the
// launcher so Nextflow and the workers share the same server.

process {
    executor = 'hq'
    cpus     = 2
    memory   = '6 GB'
    time     = '2h'
    errorStrategy = 'retry'
    maxRetries = 1
}

executor {
    // HQ schedules cheaply, so we can keep many tasks in flight.
    queueSize = (System.getenv('NXF_MAX_FORKS') ?: '100') as Integer
    pollInterval = '5 sec'
}

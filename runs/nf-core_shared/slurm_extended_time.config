// Additive Nextflow config — bump per-task time from 2h → 8h.
// Written 2026-04-28 by deployment agent. To be passed AFTER slurm.config:
//   nextflow run ... -c slurm.config -c slurm_extended_time.config
// Effect: profiled (DataLife/Darshan) workflows whose tasks otherwise hit
// the 2h cap get 4× more headroom. Original slurm.config is untouched.

process {
    time = '8h'
}

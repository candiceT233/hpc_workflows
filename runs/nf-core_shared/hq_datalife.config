// HyperQueue executor + DataLife per-task instrumentation for nf-core runs.
//
// Same HQ dispatch as hq.config, plus a beforeScript that injects libmonitor
// LD_PRELOAD + DataLife env into each task. beforeScript is prepended to the
// task's .command.sh, which runs AFTER Nextflow's conda activation, so conda
// activation stays clean. DATALIFE_JSON_OUTPUT=1 → *.r/w_blk_trace.json +
// monitor_timer.*.datalife.json (the schema verification.py validates;
// requires libmonitor built with -DTIMER_JSON=ON).
//
// Values baked from the launcher's environment at config-parse time, so the
// launcher must export DATALIFE_LIB / DATALIFE_OUTPUT_PATH / DATALIFE_FILE_PATTERNS.

process {
    executor = 'hq'
    cpus     = 2
    memory   = '6 GB'
    time     = '2h'
    errorStrategy = 'retry'
    maxRetries = 1
    beforeScript = """export LD_PRELOAD='${System.getenv('DATALIFE_LIB') ?: ''}'
export DATALIFE_OUTPUT_PATH='${System.getenv('DATALIFE_OUTPUT_PATH') ?: ''}'
export DATALIFE_FILE_PATTERNS='${System.getenv('DATALIFE_FILE_PATTERNS') ?: ''}'
export DATALIFE_JSON_OUTPUT=1
export MONITOR_SKIP_BINARIES=java"""
}

executor {
    queueSize = (System.getenv('NXF_MAX_FORKS') ?: '100') as Integer
    pollInterval = '5 sec'
}

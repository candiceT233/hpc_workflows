// DataLife-profiling Nextflow SLURM config for nf-core (Class C) multi-node runs.
//
// Extends the node-pinning behaviour of slurm_pinned.config and ADDS per-child-task
// libmonitor instrumentation. Without this, only the Nextflow JVM driver carries
// LD_PRELOAD and the actual science tools (the processes that do the real I/O) are
// never traced — runs produced only "main.nf_<driverpid>_r_stat" driver-read traces,
// BLK_COUNT=0.
//
// Mechanism: process.beforeScript is prepended to each task's .command.sh, which runs
// AFTER Nextflow's conda activation in .command.run. So conda activation stays clean
// (no LD_PRELOAD during `conda info --json` etc.) while the task's science binary runs
// under libmonitor. Values are baked from the parent sbatch environment at config-parse
// time, so the launching script must `export` DATALIFE_LIB / DATALIFE_OUTPUT_PATH /
// DATALIFE_FILE_PATTERNS before invoking nextflow.
//
// DATALIFE_JSON_OUTPUT=1 makes libmonitor emit *.r_blk_trace.json / *.w_blk_trace.json
// (the schema verification.py validates) instead of the legacy *_r_stat text format.

process {
    executor = 'slurm'
    queue    = 'compute'
    cpus     = 2
    memory   = '6 GB'
    time     = '2h'
    clusterOptions = "--nodelist=${System.getenv('SLURM_JOB_NODELIST')}"
    errorStrategy = 'retry'
    maxRetries = 1
    beforeScript = """export LD_PRELOAD='${System.getenv('DATALIFE_LIB') ?: ''}'
export DATALIFE_OUTPUT_PATH='${System.getenv('DATALIFE_OUTPUT_PATH') ?: ''}'
export DATALIFE_FILE_PATTERNS='${System.getenv('DATALIFE_FILE_PATTERNS') ?: ''}'
export DATALIFE_JSON_OUTPUT=1
export MONITOR_SKIP_BINARIES=java"""
}

executor {
    queueSize = (System.getenv('NXF_MAX_FORKS') ?: '40') as Integer
    submitRateLimit = '10 sec'
    pollInterval = '15 sec'
}

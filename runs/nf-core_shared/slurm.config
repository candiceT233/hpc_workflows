// Shared Nextflow SLURM-executor config for nf-core pipelines on Ares.
// Usage: nextflow run ... -profile test,conda -c $WORKFLOW_ROOT/runs/nf-core_shared/slurm.config
// The head Nextflow process runs on whatever node launched it; each workflow *task* is
// dispatched as its own sbatch job, so tasks spread across the cluster. Cap the number of
// concurrently-queued task jobs with process.maxForks to match the node budget for this run.

process {
    executor = 'slurm'
    queue    = 'compute'
    // default per-task allocation; nf-core tasks have their own cpu/mem labels that override
    cpus     = 2
    memory   = '6 GB'
    time     = '2h'
    clusterOptions = '--nodes=1'
    errorStrategy = 'retry'
    maxRetries = 1
}

executor {
    // Cap concurrent sbatch-submitted tasks. Override per-run via NXF_MAX_FORKS env.
    queueSize = (System.getenv('NXF_MAX_FORKS') ?: '40') as Integer
    submitRateLimit = '10 sec'
    pollInterval = '15 sec'
}

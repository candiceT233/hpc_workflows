// Shared Nextflow SLURM-executor config for multi-node nf-core profiling runs on Ares.
// Companion to slurm.config; the only delta is the clusterOptions line, which pins each
// NF child sbatch to the parent allocation's nodelist with --exclusive.
//
// Why this exists:
//   slurm.config lets NF children land on any cluster node, so a parent with
//   --nodes=24 may end up running its children on a totally disjoint set of
//   nodes — invalidating the multi-node measurement. This config keeps the
//   children on the parent's allocated nodes (Class C compliance per the
//   2026-05-18 multi-node audit, Rule 1).
//
// Usage:
//   nextflow run ... -profile test,conda -c $WORKFLOW_ROOT/runs/nf-core_shared/slurm_pinned.config
// Cap concurrency via NXF_MAX_FORKS env (typically 2-4x the parent --nodes count).

process {
    executor = 'slurm'
    queue    = 'compute'
    // default per-task allocation; nf-core tasks have their own cpu/mem labels that override
    cpus     = 2
    memory   = '6 GB'
    time     = '2h'
    // Pin children to the parent job's allocated nodes. We do NOT pass --exclusive
    // here: the parent already holds the same nodes (lightweight driver, 4 CPUs/8 GB
    // on the head node only), and SLURM treats a child's --exclusive request as
    // conflicting with the parent's hold → children pend forever on
    // Reason=ReqNodeNotAvail. Dropping --exclusive lets children pack tightly onto
    // the parent's nodes, each consuming the task.cpus/task.memory declared by the
    // nf-core process labels. Multi-node spread is still enforced by --nodelist.
    clusterOptions = "--nodelist=${System.getenv('SLURM_JOB_NODELIST')}"
    errorStrategy = 'retry'
    maxRetries = 1
}

executor {
    queueSize = (System.getenv('NXF_MAX_FORKS') ?: '40') as Integer
    submitRateLimit = '10 sec'
    pollInterval = '15 sec'
}

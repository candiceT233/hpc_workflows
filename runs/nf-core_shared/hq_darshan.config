// HyperQueue executor + Darshan per-task instrumentation for nf-core runs.
//
// Same HQ dispatch as hq.config, plus a beforeScript that injects libdarshan
// LD_PRELOAD + Darshan env into each task. beforeScript is prepended to the
// task's .command.sh, so it runs AFTER Nextflow's conda activation (clean
// activation). nf-core tasks are mostly NON-MPI single-process tools, so
// DARSHAN_ENABLE_NONMPI=1 is REQUIRED or no logs are written. Darshan writes one
// <user>_<exe>_id..._<ts>.darshan log per process at exit into
// $DARSHAN_LOGPATH/<year>/<month>/<day>/ — the launcher pre-creates that date
// subdir on each node's local disk (Darshan does not mkdir it).
//
// Rule 7: never bundle two profilers in one job. This config is the darshan-only
// sibling of hq_datalife.config. Values baked from the launcher env at parse time.

process {
    executor = 'hq'
    cpus     = 2
    memory   = '6 GB'
    time     = '2h'
    errorStrategy = 'retry'
    maxRetries = 1
    beforeScript = """export LD_PRELOAD='${System.getenv('DARSHAN_LIB') ?: ''}'
export DARSHAN_ENABLE_NONMPI=1
export DARSHAN_LOGPATH='${System.getenv('DARSHAN_LOGPATH') ?: ''}'
export DARSHAN_MODMEM='${System.getenv('DARSHAN_MODMEM') ?: '2048'}'
export DARSHAN_EXCLUDE_DIRS='${System.getenv('DARSHAN_EXCLUDE_DIRS') ?: '/proc:/sys:/dev:/etc:/usr:/var:/tmp'}'"""
}

executor {
    queueSize = (System.getenv('NXF_MAX_FORKS') ?: '100') as Integer
    pollInterval = '5 sec'
}
